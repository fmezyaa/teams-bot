# Azure Bot Credentials
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=

# Chatwoot Configuration
CHATWOOT_BASE_URL=https://chatwoot.ezyaa.de
CHATWOOT_API_ACCESS_TOKEN=

# Shared Secret fuer POST /api/chatwoot/webhook (optional, dringend empfohlen).
# Leer = Webhook ist unauthentifiziert (Legacy-Verhalten, Warnung beim Start).
# Uebergabe per Header `x-ezyaa-webhook-secret` ODER als letztes Pfadsegment
# (https://.../api/chatwoot/webhook/<secret>), weil im Postfach nur eine URL
# und keine Header hinterlegt werden koennen.
# Erzeugen: openssl rand -hex 32
CHATWOOT_WEBHOOK_SECRET=
# false (Default) = Aufrufe ohne gueltiges Secret werden noch durchgelassen und
#   mit dem Marker [webhook-unsigned] als warn geloggt (Beobachtungsphase).
# true = Aufrufe ohne gueltiges Secret bekommen 401.
CHATWOOT_WEBHOOK_ENFORCE=false

# Bridge Service
BRIDGE_BASE_URL=https://microsoft-teams-bridge.ezyaa.de
PORT=3978

# Microsoft Graph (optional contact enrichment: Standort/Position/Region)
# Separate multi-tenant app registration (NOT the Bot app above).
# Needs Application permission User.Read.All + per-customer admin consent.
# Leave empty to disable enrichment globally.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Admin / Proactive API
ADMIN_API_TOKEN=
# Optional: falls abweichend vom Admin-Token
PROACTIVE_API_TOKEN=

# PostgreSQL (set these in Coolify, not committed with real values)
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
